{
	"name": "nuxt-app",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "nuxt build",
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"release": "npx changelogen@latest --release --push",
		"test": "vitest",
		"test:coverage": "vitest --coverage"
	},
	"dependencies": {
		"@nuxt/image": "1.11.0",
		"@nuxt/ui": "4.5.1",
		"nuxt": "4.3.1",
		"tailwindcss": "^4.2.1"
	},
	"devDependencies": {
		"@iconify-json/lucide": "^1.2.96",
		"@nuxt/eslint": "^1.15.2",
		"@nuxt/test-utils": "3.19.2",
		"@vitejs/plugin-vue": "^6.0.4",
		"@vitest/coverage-v8": "^3.2.4",
		"@vue/test-utils": "^2.4.6",
		"eslint": "^9.39.4",
		"happy-dom": "20.0.2",
		"husky": "^9.1.7",
		"lint-staged": "^16.3.3",
		"playwright-core": "^1.58.2",
		"prettier": "^3.8.1",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4"
	},
	"packageManager": "pnpm@10.14.0",
	"lint-staged": {
		"app/**/*.{ts,vue}": [
			"prettier --write",
			"eslint --fix"
		]
	},
	"version": "0.0.4"
}
