{
	"name": "nuxt-app",
	"version": "0.0.4",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "nuxt build",
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"test": "vitest",
		"test:coverage": "vitest --coverage"
	},
	"dependencies": {
		"@nuxt/image": "1.11.0",
		"@nuxt/ui": "4.11.3",
		"nuxt": "4.5.2",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@iconify-json/lucide": "^1.2.115",
		"@nuxt/eslint": "^1.16.0",
		"@nuxt/test-utils": "3.19.2",
		"@vitejs/plugin-vue": "^6.0.7",
		"@vitest/coverage-v8": "^3.2.6",
		"@vue/language-server": "^3.3.6",
		"@vue/test-utils": "^2.4.11",
		"eslint": "^9.39.4",
		"happy-dom": "20.10.6",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"playwright-core": "^1.61.1",
		"prettier": "^3.9.4",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"typescript": "^5.9.3",
		"vitest": "^5.0.3",
		"vue-tsc": "^3.3.12"
	},
	"packageManager": "pnpm@10.14.0",
	"lint-staged": {
		"app/**/*.{ts,vue}": [
